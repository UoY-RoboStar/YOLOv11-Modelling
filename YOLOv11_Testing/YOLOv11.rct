package yolov11

type BoundingBoxType
type ConfidenceType


function linear(x:real):real {}


anncontroller YOLOv11S {
		//ANN Controller context
		event image : Tensor3D(640, 640, 3)
		event boundingBoxes : BoundingBoxType
		event confidence : ConfidenceType
		
		//Connections
		connection YOLOv11S on image to RCB1 on input
		
		//ANN Blocks (RCB1, represents blocks B1-B2 of YOLOv11)
		convblock RCB1 {

			activation = linear
			outputfunction = linear
			/*
			 * Weights shape: <(320 x 320 x 32 x 3 x 3 x 3), (160 x 160 x 64 x 32 x 3 x 3)>
			 * Biases shape: Sequence of size 2. 
			 */
			file = "RCB1-Weights.csv"
			
			//Layer structure is expected (for a convolutional layer) to be a sequence of tuples capturing the layer structure. 
			layerstructure = [| [| 320, 320, 32|], [| 160, 160, 64|] |]
			
			//Desired shapes are sequences of natural numbers
			strides = [| 2,2|] 
			paddings = [| 0,0 |]
			//Desired type is a sequence of pairs, we are only considering 2D convolutions. 
			kernelSizes = [| [|3,3|], [| 3,3 |] |] 
			
			
			//I/O Contexts
			inputContext {
				event input : Tensor3D(640, 640, 3)
			}
			
			outputContext {
				event output : Tensor3D(160, 160, 64)
			}
			
			//Optional Normalisation Block
			batch normalisation {
				/*
				 * Shape of each parameter (weights, biases, means, variances) is  
				 * Shape: <(320 x 320 x 64), (320 x 320 x 32)>
				 */
				//Trained Parameters (both are optional)
				weights = <>
				file = "RCB1-BN-Weights.csv"
				
				//Statistical Parameters (obtained from running averages during training time) 
				means = <>
				variances = <>
			}
		}
		
		
		//RCB21
		
		compblock RCB2 {
		  
			inputContext {
				event input : Tensor3D(160, 160, 64)
			}
			outputContext {
				event output : Tensor3D(160, 160, 128)
			}
			connection RCB2 on input to RCB21 on input
			connection RCB21 on output to RCB2S1 on input
			connection RCB2S1 on output1 to RCB22 on input
			
			convblock RCB21 {
				inputContext {
					event input : Tensor3D(160, 160, 64)
				}
				outputContext {
					event output : Tensor3D(160, 160, 64)
				}
				paddings = [|0|]
				strides = [|0|]
				kernelSizes = [|0|]
				activation = linear
				weights = <> 
				layerstructure = [|0|]
				
				batch normalisation {
					weights = <>
					file = "RCB21-BN-Weights.csv"
				
					//Statistical Parameters (obtained from running averages during training time) 
					means = <>
					variances = <>
				}
			}
			
			splitBlock RCB2S1 {
				inputContext {
					event input : Tensor3D(160, 160, 64)
				}
				outputContext {
					ordevent output1 : Tensor3D(160, 160, 32) 1
					ordevent output2 : Tensor3D(160, 160, 32) 2
				}
				2
			}
			
			convblock RCB22 {
				inputContext {
					event input : Tensor3D(160, 160, 32)
				}
				outputContext {
					event output : Tensor3D(160, 160, 32)
				}
				paddings = [|0|]
				strides = [|0|]
				kernelSizes = [|0|]
				activation = linear
				weights = <> 
				layerstructure = [|0|]
				
				batch normalisation {
					weights = <>
					file = "RCB21-BN-Weights.csv"
				
					//Statistical Parameters (obtained from running averages during training time) 
					means = <>
					variances = <>
				}
			}
			
			
			
		}
	}


