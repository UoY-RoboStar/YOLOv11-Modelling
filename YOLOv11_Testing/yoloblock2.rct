				 */
				//Trained Parameters (both are optional)
				weights = <>
				file = "RCB1-BN-Weights.csv"
				
				//Statistical Parameters (obtained from running averages during training time) 
				means = <>
				variances = <>
			}
			
			//I/O Contexts
			outputContext {
				event out1 : Tensor3D(40,40,256)
				event out2 : Tensor3D(40,40,256)
			}
		inputContext {
				event in1 : Tensor3D(40,40,768)
			}

	}
	
	convblock Upsample2 {

			activation = linear
			outputfunction = linear
			/*
			 * Weights shape: <(320 x 320 x 32 x 3 x 3 x 3), (160 x 160 x 64 x 32 x 3 x 3)>
			 * Biases shape: Sequence of size 2. 
			 */
			file = "RCB1-Weights.csv"
			
			//Layer structure is expected (for a convolutional layer) to be a sequence of tuples capturing the layer structure. 
			layerstructure = [| [| 320, 320, 32|], [| 160, 160, 64|] |]
			
			//Desired shapes are sequences of natural numbers
			strides = [| 2,2|] 
			paddings = [| 0,0 |]
			//Desired type is a sequence of pairs, we are only considering 2D convolutions. 
			kernelSizes = [| [|3,3|], [| 3,3 |] |] 
			
			
			
			
			//Optional Normalisation Block
			batch normalisation {
				/*
				 * Shape of each parameter (weights, biases, means, variances) is  
				 * Shape: <(320 x 320 x 64), (320 x 320 x 32)>
				 */
				//Trained Parameters (both are optional)
				weights = <>
				file = "RCB1-BN-Weights.csv"
				
				//Statistical Parameters (obtained from running averages during training time) 
				means = <>
				variances = <>
			}
			
			//I/O Contexts
			outputContext {
				event out1 : Tensor3D(80,80,256)
			}
		inputContext {
				event in1 : Tensor3D(40,40,256)
			}

	}
	
	convblock Concat3 {

			activation = linear
			outputfunction = linear
			/*
			 * Weights shape: <(320 x 320 x 32 x 3 x 3 x 3), (160 x 160 x 64 x 32 x 3 x 3)>
			 * Biases shape: Sequence of size 2. 
			 */
			file = "RCB1-Weights.csv"
			
			//Layer structure is expected (for a convolutional layer) to be a sequence of tuples capturing the layer structure. 
			layerstructure = [| [| 320, 320, 32|], [| 160, 160, 64|] |]
			
			//Desired shapes are sequences of natural numbers
			strides = [| 2,2|] 
			paddings = [| 0,0 |]
			//Desired type is a sequence of pairs, we are only considering 2D convolutions. 
			kernelSizes = [| [|3,3|], [| 3,3 |] |] 
			
			
			
			
			//Optional Normalisation Block
			batch normalisation {
				/*
				 * Shape of each parameter (weights, biases, means, variances) is  
				 * Shape: <(320 x 320 x 64), (320 x 320 x 32)>
				 */
				//Trained Parameters (both are optional)
				weights = <>
				file = "RCB1-BN-Weights.csv"
				
				//Statistical Parameters (obtained from running averages during training time) 
				means = <>
				variances = <>
			}
			
			//I/O Contexts
			outputContext {
				event out1 : Tensor3D(80, 80, 512)
			}
		inputContext {
				event in1 : Tensor3D(80, 80, 256)
				event in2 : Tensor3D(80, 80, 256)
			}

	}
	
	convblock ANNBlock4 {

			activation = linear
			outputfunction = linear
			/*
			 * Weights shape: <(320 x 320 x 32 x 3 x 3 x 3), (160 x 160 x 64 x 32 x 3 x 3)>
			 * Biases shape: Sequence of size 2. 
			 */
			file = "RCB1-Weights.csv"
			
			//Layer structure is expected (for a convolutional layer) to be a sequence of tuples capturing the layer structure. 
			layerstructure = [| [| 320, 320, 32|], [| 160, 160, 64|] |]
			
