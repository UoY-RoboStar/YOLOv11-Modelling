			}
		inputContext {
				event in1 : Tensor3D(80, 80, 128)
			}

	}
	
	convblock Concat4 {

			activation = linear
			outputfunction = linear
			/*
			 * Weights shape: <(320 x 320 x 32 x 3 x 3 x 3), (160 x 160 x 64 x 32 x 3 x 3)>
			 * Biases shape: Sequence of size 2. 
			 */
			file = "RCB1-Weights.csv"
			
			//Layer structure is expected (for a convolutional layer) to be a sequence of tuples capturing the layer structure. 
